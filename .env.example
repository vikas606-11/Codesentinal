# Copy to .env (Docker Compose reads it) -- never commit the real .env
APP_NAME=CodeSentinel
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional (Chunk 2). Defaults are fine for the demo. ---
# Rule sources for Semgrep: folders, files, or registry packs (comma-separated).
# Default = the bundled offline rules in backend/rules
# SEMGREP_CONFIG=p/python
# MAX_UPLOAD_MB=20
# MAX_UNZIPPED_MB=100
# SCAN_TIMEOUT_SECONDS=180

# --- Optional (Chunk 3) ---
# TRIVY_TIMEOUT_SECONDS=600
# Set true to re-download Trivy's vulnerability database on every scan (default: reuse the cached one)
# TRIVY_REFRESH_DB=false

# --- Optional (Chunk 4) ---
# Quality gate: a scan passes when score >= this value
# QUALITY_GATE_THRESHOLD=70
# DATABASE_PATH=/app/data/codesentinel.db

# --- AI explanations (Chunk 6) ---
# mock = built-in explanations, no key and no internet needed (default)
# anthropic = Claude API,  openai = OpenAI or any OpenAI-compatible API
AI_PROVIDER=mock
AI_API_KEY=
# Leave empty for the provider's default model. Model names change, so check the provider's docs.
AI_MODEL=
# Leave empty for the official address. For other OpenAI-compatible services set it, for example:
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama : http://host.docker.internal:11434/v1   (set AI_API_KEY to any text)
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
